<div class="container home-page__container">
    {{ include('partials/components/text', { heading, text }) }}

    {{ rich_text(richText) }}
</div>

{% schema %}
{
    "heading": {
        "type": "string"
    },
    "text": {
        "type": "string"
    },
    "richText": {
        "type": "rich-text"
    }
}
{% endschema %}

{% editor %}
{
    "name": "Text",
    "controls": [
        {
            "control": "textarea",
            "label": "Text",
            "value": {
                "$ref": "#/schema/text"
            }
        },
        {
            "control": "rich-text",
            "label": "RICH TEXT",
            "value": {
                "$ref": "#/schema/richText"
            }
        }
    ]
}
{% endeditor %}